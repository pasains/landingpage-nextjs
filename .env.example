# URL Web App dari Google Apps Script.
# Deploy: Execute as "Me", Access "Anyone".
GOOGLE_SHEET_SCRIPT_URL=https://script.google.com/macros/s/XXXXX/exec

# Shared secret untuk endpoint /api/revalidate.
# Panggil dari Apps Script (trigger onFormSubmit) dengan header:
#   x-revalidate-secret: <nilai di bawah>
REVALIDATE_SECRET=ganti-dengan-string-acak-yang-panjang
